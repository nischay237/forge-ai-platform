# FORGE Platform — Required Environment Configuration
# Copy to .env and replace all placeholder values before running Docker Compose or production profile.
# Generate cryptographically random keys:
#   openssl rand -base64 48   -> FORGE_JWT_SECRET
#   openssl rand -base64 32   -> FORGE_ENCRYPTION_KEY

POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# Mandatory production application secrets (application fails startup if missing or weak)
FORGE_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64
FORGE_ENCRYPTION_KEY=REPLACE_WITH_EXACT_32_BYTE_AES256_BASE64_KEY
FORGE_ENCRYPTION_KEY_ID=k1
# Optional rotation keyring: comma-separated keyId:base64Key entries for decrypting prior ciphertexts
FORGE_ENCRYPTION_PREVIOUS_KEYS=

# Optional AI & CORS settings
FORGE_OPENAI_API_KEY=
FORGE_OPENAI_MODEL=gpt-4o-mini
FORGE_AI_PROVIDER=hybrid
FORGE_CORS_ORIGINS=http://localhost:5173
FORGE_SWAGGER_ENABLED=false
